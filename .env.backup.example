# Configuración de Respaldo - Sistema Brisas
# Copiar a .env.backup y ajustar valores

# Base de Datos MySQL
DB_BACKUP_HOST=127.0.0.1
DB_BACKUP_PORT=3306
DB_BACKUP_DATABASE=sistema2
DB_BACKUP_USERNAME=root
DB_BACKUP_PASSWORD=

# Cifrado GPG
GPG_RECIPIENT=backup@brisas.com
GPG_PASSPHRASE=

# Almacenamiento Remoto con Rclone
RCLONE_REMOTE=brisas_drive
RCLONE_REMOTE_PATH=backups/brisas

# Notificaciones Webhook
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
WEBHOOK_ENABLED=true

# Configuración de Respaldo
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_SOURCE_CODE_ENABLED=false
BACKUP_FULL_WEEKLY=true

# Logs
LOG_RETENTION_DAYS=7
LOG_MAX_SIZE_MB=100
